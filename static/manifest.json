{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.7.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "121",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "edition.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "edition.js",
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "edition.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "speedia@glerme",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/Glerme/Speedia/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
